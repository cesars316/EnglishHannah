# English Quest - variables de entorno de ejemplo.
# Copia este archivo a .env.local y rellena los valores.
# NUNCA subas .env.local a Git ni escribas credenciales reales aqui.

# --- Entorno ---
NODE_ENV=development
# URL base publica de la app (usada para cookies y enlaces absolutos).
APP_BASE_URL=http://localhost:3000

# --- MongoDB ---
# Desarrollo local (`npm run db:up` levanta MongoDB 8 con Docker):
MONGODB_URI=mongodb://localhost:27017
# Produccion (MongoDB Atlas Free). Reemplaza los placeholders:
# MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=english_quest

# Base de datos usada por las pruebas de integracion (se limpia entre pruebas).
# Si no se define, se usa `english_quest_test` sobre MONGODB_URI.
# MONGODB_URI_TEST=mongodb://localhost:27017

# --- Seguridad de sesion ---
# Secreto largo y aleatorio para firmar la cookie de sesion del adulto/dispositivo.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# --- Solo desarrollo / pruebas ---
# Adelanta el reloj del servidor en milisegundos para probar el repaso sin
# esperar dias reales. Se ignora en produccion. Se usa en los E2E.
# REVIEW_TIME_OFFSET_MS=172800000

# --- Opcionales / futuro (no requeridas en el MVP) ---
# Si algun dia se activa Google OAuth con Auth.js, definir aqui (nunca en el codigo):
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
